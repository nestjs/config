{
  "name": "@nestjs/config",
  "version": "12.0.1",
  "type": "module",
  "description": "Nest - modern, fast, powerful node.js web framework (@config)",
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "url": "https://github.com/nestjs/config#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write \"{lib,test}/**/*.ts\"",
    "lint": "oxlint lib/ --fix",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:integration": "vitest run --config vitest.config.mts",
    "prerelease": "npm run build",
    "release": "release-it"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "dotenv": "18.0.3",
    "dotenv-expand": "13.0.0",
    "es-toolkit": "1.52.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-angular": "21.2.3",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/testing": "12.1.0",
    "@types/lodash": "4.17.25",
    "@types/node": "24.13.6",
    "husky": "9.1.7",
    "joi": "18.2.9",
    "lint-staged": "17.5.1",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "reflect-metadata": "0.2.2",
    "release-it": "21.1.0",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "rxjs": "^7.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -c .commitlintrc.json -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs/config"
  }
}
